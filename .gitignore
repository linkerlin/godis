# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Root-level build output (Linux/macOS/Windows)
# `go build -o godis ./` produces these in the repo root.
/godis
/godis.exe

# Persistence files (AOF / RDB / snapshots)
/*.aof
/*.rdb
/*.incr.aof

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool
*.out
/coverage
/coverage.txt
/target/

# Cluster node data dirs (Raft DB, snapshots, logs)
node1/
node2/
node3/
logs/

# Cluster integration test artifacts
cluster/core/test/

# Temporary scratch space
/tmp/

# Editor / IDE
.idea/
.vscode/
*.iml

# Local config overrides
redis2.conf
*.local.conf
